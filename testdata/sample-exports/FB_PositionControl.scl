FUNCTION_BLOCK "FB_PositionControl"
VAR_INPUT
    Enable : Bool;
    TargetPosition : Real;
    ActualPosition : Real;
END_VAR
VAR_OUTPUT
    InPosition : Bool;
    Error : Bool;
END_VAR
VAR
    PositionError : Real;
END_VAR
BEGIN
    // Simple example for offline parser tests
    PositionError := TargetPosition - ActualPosition;
    InPosition := ABS(PositionError) < 0.1;
    Error := Enable AND (ABS(PositionError) > 1000.0);
END_FUNCTION_BLOCK
